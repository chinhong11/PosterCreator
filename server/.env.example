# Copy to server/.env and fill in. The server loads this file at startup;
# variables already set in your shell take precedence.

# Which model designs the posters: "anthropic" (default) or "gemini".
LLM_PROVIDER=anthropic

# --- Anthropic (Claude) ---
# Alternatively, run `ant auth login` and leave the key unset — the SDK
# resolves an OAuth profile automatically.
ANTHROPIC_API_KEY=
# Optional: override the Claude model (default: claude-opus-5).
# ANTHROPIC_MODEL=claude-opus-5

# --- Google (Gemini) --- used when LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# Required with Gemini: a model ID your key can use (see Google AI Studio).
# GEMINI_MODEL=
# Optional output cap. Unset uses the model's own maximum, which avoids
# errors if a model's limit is lower than ours.
# GEMINI_MAX_OUTPUT_TOKENS=

# Port the API server listens on (default 8787).
PORT=8787

# Optional shared password to gate the app when hosting publicly. If set, the
# UI shows a login screen and the API requires a token. Leave unset for open,
# local development. (Personal-deploy gate — everyone who logs in shares the
# same posters; it is not multi-user accounts.)
# APP_PASSWORD=change-me

# If deploying behind a reverse proxy (nginx, a load balancer), set this so the
# rate limiter sees the real client IP via X-Forwarded-For. Value is "true"
# (trust all — only if the proxy is trusted), a hop count like "1", or a subnet.
# Leave unset for local development.
# TRUST_PROXY=1
