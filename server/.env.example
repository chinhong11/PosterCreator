# Copy to .env and fill in. The server reads ANTHROPIC_API_KEY at startup.
# Alternatively, run `ant auth login` and leave this unset — the SDK resolves
# an OAuth profile automatically.
ANTHROPIC_API_KEY=

# Port the API server listens on (default 8787).
PORT=8787

# Optional shared password to gate the app when hosting publicly. If set, the
# UI shows a login screen and the API requires a token. Leave unset for open,
# local development. (Personal-deploy gate — everyone who logs in shares the
# same posters; it is not multi-user accounts.)
# APP_PASSWORD=change-me

# If deploying behind a reverse proxy (nginx, a load balancer), set this so the
# rate limiter sees the real client IP via X-Forwarded-For. Value is "true"
# (trust all — only if the proxy is trusted), a hop count like "1", or a subnet.
# Leave unset for local development.
# TRUST_PROXY=1
